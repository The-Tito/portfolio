# Copy to .env.local and fill in. Never commit real values.

# Public base URL used for metadata, sitemap and OG images (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (phase 5) — provisioned through the Vercel Marketplace (Resend).
RESEND_API_KEY=
# Address that receives contact-form messages.
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Portafolio <hola@tu-dominio.com>".
CONTACT_FROM_EMAIL=
